<?xml version="1.0" encoding="utf-8"?>
<!--
   Sao lưu / chuyển máy (API 31+). Không mang theo token đăng nhập (ADR-016): người chơi đăng nhập
   lại trên máy mới.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="linguacity_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="linguacity_auth.xml" />
    </device-transfer>
</data-extraction-rules>
