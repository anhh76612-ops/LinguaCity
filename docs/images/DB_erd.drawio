  <diagram name="Page-1" id="6PwDd3sZP54ms3jOmuWJ">
    <mxGraphModel dx="4376" dy="1948" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    %% =========================================================\n    %% STATIC CONTENT\n    %% =========================================================\n\n    THEME ||--o{ BUILDING : \&quot;1-N\&quot;\n    THEME ||--o{ VOCABULARY : \&quot;1-N\&quot;\n\n    BUILDING ||--o{ BUILDING_LEVEL : \&quot;1-N\&quot;\n    BUILDING ||--o{ BLUEPRINT : \&quot;1-N\&quot;\n    BUILDING ||--o{ EXAM : \&quot;1-N\&quot;\n\n    %% Logical mapping:\n    %% BUILDING_LEVEL(building_id, level)\n    %% &lt;-&gt; BLUEPRINT(building_id, target_level)\n    BUILDING_LEVEL ||--|| BLUEPRINT : \&quot;target level mapping\&quot;\n\n    %% =========================================================\n    %% PLAYER STATE\n    %% =========================================================\n\n    USER_PROFILE ||--o{ USER_BUILDING : \&quot;1-N\&quot;\n    USER_PROFILE ||--o{ USER_VOCAB_PROGRESS : \&quot;1-N\&quot;\n    USER_PROFILE ||--o{ USER_BLUEPRINT : \&quot;1-N\&quot;\n    USER_PROFILE ||--o{ EXAM_ATTEMPT : \&quot;1-N\&quot;\n\n    BUILDING ||--o{ USER_BUILDING : \&quot;1-N\&quot;\n    VOCABULARY ||--o{ USER_VOCAB_PROGRESS : \&quot;1-N\&quot;\n    BLUEPRINT ||--o{ USER_BLUEPRINT : \&quot;1-N\&quot;\n\n    %% =========================================================\n    %% QUESTION / VOCABULARY\n    %% =========================================================\n\n    QUESTION ||--o{ QUESTION_VOCABULARY : \&quot;1-N\&quot;\n    VOCABULARY ||--o{ QUESTION_VOCABULARY : \&quot;1-N\&quot;\n\n    %% =========================================================\n    %% EXAM DEFINITION / QUESTION POOL\n    %% =========================================================\n\n    EXAM ||--|| EXAM_REQUIREMENT : \&quot;1-1\&quot;\n\n    EXAM ||--o{ EXAM_QUESTION : \&quot;1-N\&quot;\n    QUESTION ||--o{ EXAM_QUESTION : \&quot;1-N\&quot;\n\n    %% Exam reward\n    BLUEPRINT ||--o{ EXAM : \&quot;1-N\&quot;\n\n    %% =========================================================\n    %% EXAM ATTEMPT\n    %% =========================================================\n\n    EXAM ||--o{ EXAM_ATTEMPT : \&quot;1-N\&quot;\n\n    EXAM_ATTEMPT ||--o{ EXAM_ATTEMPT_QUESTION : \&quot;1-N\&quot;\n    QUESTION ||--o{ EXAM_ATTEMPT_QUESTION : \&quot;1-N\&quot;\n\n\n    %% =========================================================\n    %% ENTITY DEFINITIONS\n    %% =========================================================\n\n    THEME {\n        BIGINT id PK\n        VARCHAR code UK\n        VARCHAR name\n        TEXT description\n    }\n\n    BUILDING {\n        BIGINT id PK\n        VARCHAR code UK\n        BIGINT theme_id FK\n        INT max_level\n    }\n\n    BUILDING_LEVEL {\n        BIGINT building_id PK, FK\n        INT level PK\n        INT knowledge_cost\n        INT construction_time\n    }\n\n    BLUEPRINT {\n        BIGINT id PK\n        VARCHAR code UK\n        BIGINT building_id FK\n        INT target_level\n    }\n\n    VOCABULARY {\n        BIGINT id PK\n        VARCHAR word\n        VARCHAR meaning\n        VARCHAR word_type\n        VARCHAR ipa\n        JSONB examples\n        VARCHAR image_url\n        BIGINT theme_id FK\n        INT level\n        VARCHAR difficulty_rank\n    }\n\n    QUESTION {\n        BIGINT id PK\n        ENUM content_type\n        ENUM skill\n        ENUM question_type\n        TEXT question_text\n        TEXT answer\n        TEXT explanation\n        VARCHAR audio_url\n        JSONB metadata\n    }\n\n    QUESTION_VOCABULARY {\n        BIGINT question_id PK, FK\n        BIGINT vocabulary_id PK, FK\n        ENUM relation_type\n    }\n\n    EXAM {\n        BIGINT id PK\n        VARCHAR code UK\n        BIGINT building_id FK\n        INT target_level\n        BIGINT reward_blueprint_id FK\n        INT question_count\n    }\n\n    EXAM_REQUIREMENT {\n        BIGINT id PK\n        BIGINT exam_id FK UK\n        INT required_card_count\n        INT required_knowledge\n        INT required_blueprint_shards\n    }\n\n    %% Question Pool\n    EXAM_QUESTION {\n        BIGINT exam_id PK, FK\n        BIGINT question_id PK, FK\n    }\n\n    USER_PROFILE {\n        UUID id PK\n        INT knowledge_points\n        INT hourglass_count\n        INT blueprint_shards\n    }\n\n    USER_BUILDING {\n        BIGINT id PK\n        UUID user_id FK\n        BIGINT building_id FK\n        INT current_level\n        INT target_level\n        BOOLEAN is_unlocked\n        ENUM status\n        TIMESTAMP started_at\n        TIMESTAMP finish_at\n    }\n\n    USER_VOCAB_PROGRESS {\n        BIGINT id PK\n        UUID user_id FK\n        BIGINT vocabulary_id FK\n        INT mastery_score\n        TIMESTAMP first_seen_at\n        TIMESTAMP last_reviewed_at\n    }\n\n    USER_BLUEPRINT {\n        BIGINT id PK\n        UUID user_id FK\n        BIGINT blueprint_id FK\n        INT quantity\n    }\n\n    EXAM_ATTEMPT {\n        BIGINT id PK\n        UUID user_id FK\n        BIGINT exam_id FK\n        ENUM status\n        TIMESTAMP started_at\n        TIMESTAMP completed_at\n    }\n\n    %% Actual Question Set + Result of one Attempt\n    EXAM_ATTEMPT_QUESTION {\n        BIGINT attempt_id PK, FK\n        BIGINT question_id PK, FK\n        INT question_order\n        JSONB answer_payload\n        BOOLEAN is_correct\n        TIMESTAMP answered_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1IGtroczmOFksuJmPPdg-1940">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
