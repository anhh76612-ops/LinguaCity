test('bridge assist corrects a two-cell river swipe and extends the dry approach', () => {
  const bent = extendStroke(extendStroke(line({ x: -5, z: 1 }, { x: 1, z: 1 }), { x: 1, z: 3 }),
    { x: 3, z: 3 });
