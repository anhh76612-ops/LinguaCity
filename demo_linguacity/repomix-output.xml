}
.select-icon::before { inset: 1px 5px 0; background: #684a34; transform: rotate(-12deg); }
.select-icon::after { inset: 4px 8px 4px; background: linear-gradient(125deg, #fff5d9, #eac587); transform: rotate(-12deg); }
.arrange-icon::before {
  inset: 4px 5px 4px;
  border: 2px solid #6c593c;
  border-radius: 4px;
  background:
    linear-gradient(90deg, transparent 45%, #725b3d 45% 55%, transparent 55%),
    linear-gradient(transparent 44%, #725b3d 44% 55%, transparent 55%),
    conic-gradient(#a8b77a 0 25%, #d0a573 25% 50%, #a3ac71 50% 75%, #e4bf8a 75% 100%);
  transform: rotate(-15deg) skewX(10deg);
}
.road-icon::before {
  inset: 2px 0;
  clip-path: polygon(31% 0, 69% 0, 100% 100%, 0 100%);
  background: linear-gradient(90deg, #684d37 0 8%, #e9bf81 8% 14%, #6d655a 14% 86%, #e9bf81 86% 92%, #684d37 92%);
}
.road-icon::after { inset: 3px calc(50% - 1px); background: repeating-linear-gradient(#fff4d5 0 4px, transparent 4px 8px); }
.build-icon::before {
  left: 13px; top: 7px; width: 8px; height: 26px;
  border: 1px solid #704827; border-radius: 4px;
  background: linear-gradient(90deg, #ce9b63, #a06038);
  transform: rotate(38deg);
}
.build-icon::after {
  left: 13px; top: 4px; width: 20px; height: 12px;
  border: 1px solid #514c43; border-radius: 4px 3px 3px 4px;
  background: linear-gradient(#b6b3a1, #7f837a);
  transform: rotate(38deg);
}
.swatch { display: inline-block; width: 14px; height: 14px; border: 1px solid #795b43; border-radius: 4px; }
.swatch.dirt { background: radial-gradient(circle at 30% 30%, #e6b782 15%, transparent 18%), #ba885a; }
.swatch.stone {
  background: linear-gradient(90deg, transparent 44%, #8b7764 44% 55%, transparent 55%),
    linear-gradient(transparent 44%, #8b7764 44% 55%, transparent 55%), #c7b7a1;
}
.swatch.asphalt { background: linear-gradient(transparent 40%, #f6e6bd 40% 59%, transparent 59%), #776f66; }
[hidden] { display: none !important; }

@media (max-width: 850px) {
  .controls { grid-template-columns: minmax(0, 1fr); justify-items: center; gap: 11px; }
  #status { justify-self: center; text-align: center; }
  .dock { justify-items: center; max-width: 100%; }
  .action-row, .group, .context-tools { justify-content: center; }
}
@media (max-width: 700px) and (orientation: portrait) {
  .game { align-content: center; gap: 13px; }
  .viewport { height: auto; aspect-ratio: 4 / 3; }
  .controls { position: static; width: calc(100% - 24px); padding-bottom: max(12px, env(safe-area-inset-bottom)); }
  .tool { min-width: 71px; padding-inline: 5px; }
  .tool-label { padding-inline: 5px; }
}
@media (max-height: 490px) and (orientation: landscape) {
  .controls { bottom: max(11px, env(safe-area-inset-bottom)); grid-template-columns: minmax(0, 1fr) auto; justify-items: stretch; }
  .dock { gap: 7px; justify-items: end; }
  .tool { min-width: 69px; padding: 4px 4px 3px; border-radius: 13px 13px 9px 9px; }
  .tool-icon { height: 25px; transform: scale(.78); transform-origin: center top; }
  .context-tools { padding: 4px; }
  button { min-height: 38px; padding: 3px 7px; }
  #status { justify-self: start; text-align: start; font-size: .68rem; }
}
@media (prefers-reduced-motion: reduce) {
  button, .scene-fade { transition: none; }
}
