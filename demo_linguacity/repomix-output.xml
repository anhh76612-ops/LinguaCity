    if (!reducedMotion.matches) elapsed += Math.min(.05, last ? (now - last) / 1000 : .016);
    last = now;
    updateWater(elapsed);
    controls?.update(elapsed, !reducedMotion.matches);
    renderer.render(scene, camera);
    requestAnimationFrame(animate);
