    if (town) return '';
    const entrance = (cell.x === 7 || cell.x === 8) && (cell.z === -6 || cell.z === -5);
    if (!entrance && (closestHillRoad(cell.x + .5, cell.z + .5)?.distance ?? Infinity) < 1.52) {
