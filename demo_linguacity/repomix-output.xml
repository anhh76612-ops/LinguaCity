button[aria-pressed='true']:not(.tool) { background: var(--green); border-color: #344f38; color: #fff8e8; }
button.primary:not(.tool) { background: linear-gradient(#f7c16e, #e5a04f); border-color: #884f2a; }
button:disabled { opacity: .62; cursor: default; }
button:active:not(:disabled) { transform: translateY(var(--press-depth)) scaleX(1.04); box-shadow: var(--down-shadow); transition-duration: 80ms; }
