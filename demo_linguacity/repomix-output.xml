  }).error, /biển/);
  assert.match(planRoadStroke({
    ...basic, waterAt: x => x >= -2 && x < 6 ? { kind: 'river', y: 0 } : null,
  }).error, /tối đa 6/);
});

test('a street reports its true slope and requests only bounded land grading', () => {
  const options = {
    ...basic, width: 2, waterAt: () => null,
    cells: line({ x: 0, z: 0 }, { x: 3, z: 0 }),
