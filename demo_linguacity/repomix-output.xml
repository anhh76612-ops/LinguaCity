  assert.ok(!car.has('town-bridge:1:0'));
  assert.ok(landscape.bridge.every(point => point.y >= surfaceY(point.x, point.z) - .04));
  assert.ok([...car.values()].every(node => node.section.width >= 2));
  const trips = townTrips(car);
